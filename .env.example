# نموذج التواصل — app/api/contact
#
# انسخ هذا الملف إلى .env.local للتطوير المحلي. على الإنتاج تُضاف هذه القيم
# كأسرار في الـ Worker، لا في هذا الملف:
#
#   npx wrangler secret put ZEPTOMAIL_TOKEN
#   npx wrangler secret put CONTACT_FROM
#
# بدونها لا ينكسر شيء: المسار يرد 501 ويعود النموذج إلى فتح برنامج البريد
# لدى الزائر.

# رمز "Send Mail Token" من وكيل البريد (Mail Agent) في zeptomail.com
# لا يُرسل SMTP: مسار الموقع على Cloudflare Workers لا يفتح اتصال SMTP إطلاقًا،
# فالإرسال يتم عبر واجهة ZeptoMail الـ REST.
ZEPTOMAIL_TOKEN=

# المُرسِل — لازم يكون على نطاق موثّق داخل ZeptoMail
CONTACT_FROM="no-reply@awjhub.com"

# صندوق الاستقبال في Zoho. اتركه فارغًا ليستعمل site.email في lib/content.ts
CONTACT_TO=info@awjhub.com

# مضيف الواجهة الإقليمي. اتركه فارغًا لحساب على مركز البيانات العالمي (.com).
# لحساب أوروبي: api.zeptomail.eu — ولحساب هندي: api.zeptomail.in
ZEPTOMAIL_HOST=
