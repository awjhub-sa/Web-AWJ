# نموذج التواصل — app/api/contact
#
# انسخ هذا الملف إلى .env.local واملأ القيم، أو أضفها في إعدادات المشروع على
# Vercel. بدونها يعمل النموذج بالسلوك القديم: يفتح برنامج البريد لدى الزائر.

# المفتاح من https://resend.com/api-keys
RESEND_API_KEY=

# المُرسِل — لازم يكون على نطاق موثّق داخل Resend
CONTACT_FROM="أوج لحلول الأعمال <no-reply@awjhub.com>"

# صندوق الاستقبال. اتركه فارغًا ليستعمل site.email في lib/content.ts
CONTACT_TO=info@awjhub.com
